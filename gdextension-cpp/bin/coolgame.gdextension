[configuration]

entry_symbol = "CoolGame_library_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]

macos.debug = "./libcoolgame.macos.template_debug.framework"
macos.release = "./libcoolgame.macos.template_release.framework"
ios.debug = "./libcoolgame.ios.template_debug.xcframework"
ios.release = "./libcoolgame.ios.template_release.xcframework"
windows.debug.x86_32 = "./libcoolgame.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "./libcoolgame.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "./libcoolgame.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./libcoolgame.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./libcoolgame.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./libcoolgame.linux.template_release.x86_64.so"
linux.debug.arm64 = "./libcoolgame.linux.template_debug.arm64.so"
linux.release.arm64 = "./libcoolgame.linux.template_release.arm64.so"
linux.debug.rv64 = "./libcoolgame.linux.template_debug.rv64.so"
linux.release.rv64 = "./libcoolgame.linux.template_release.rv64.so"
android.debug.x86_64 = "./libcoolgame.android.template_debug.x86_64.so"
android.release.x86_64 = "./libcoolgame.android.template_release.x86_64.so"
android.debug.arm64 = "./libcoolgame.android.template_debug.arm64.so"
android.release.arm64 = "./libcoolgame.android.template_release.arm64.so"

[dependencies]
ios.debug = {
    "./libgodot-cpp.ios.template_debug.xcframework": ""
}
ios.release = {
    "./libgodot-cpp.ios.template_release.xcframework": ""
}